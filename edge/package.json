{
  "name": "greenhouse-edge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "migrate": "tsx src/db/migrate.ts",
    "mock-actuator": "tsx src/coap/mock-actuator.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "coap": "^1.4.0",
    "fastify": "^5.0.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
