# Edge service configuration. Copy to edge/.env for development (gitignored).
# Production: deploy/install.sh writes /etc/greenhouse/edge.env (root, 0600) instead.
#
# Precedence: real process env > .env (process.loadEnvFile does not override) > schema defaults.
# Validation is fail-closed: a bad value stops the service at boot and the log lists every bad key.
#
# Every key below matches edge/src/config/schema.ts (EnvSchema) or edge/src/config/index.ts
# (DB timeouts). The MOCK_* block is read only by the standalone mock actuator
# (edge/src/coap/mock-actuator.ts), not by the edge.
# Runtime tunables (thresholds, max run, daily cap, min interval, expiry, retries, stale
# timeout, auto on/off) are NOT here. They live in the DB `settings` table, changed via
# PUT /api/settings. The values in SETTINGS_DEFAULTS are the fallback until then.

# ───── process ─────

# development | production | test. Default: production.
NODE_ENV=development

# trace | debug | info | warn | error. Default: info. Logs are pino JSON on stdout (journald in prod).
LOG_LEVEL=info

# ───── HTTP API and dashboard ─────

# Address the HTTP API binds to. Default: 127.0.0.1 (loopback only).
# install.sh sets this to the Pi's LAN IPv4. Never 0.0.0.0 unless you have a firewall in front.
HTTP_HOST=127.0.0.1

# TCP port for the API, /healthz and the dashboard. Default: 8080. Allow on the LAN only.
HTTP_PORT=8080

# Bearer token for all POST/PUT endpoints. REQUIRED, at least 16 characters, no default.
# Leave empty here on purpose so a copied example fails closed.
# Generate one: openssl rand -hex 32
API_TOKEN=

# Directory of the built dashboard, served at /. Relative paths resolve against the process cwd
# (edge/ in development). install.sh writes an absolute path. Default: ../dashboard/dist.
DASHBOARD_DIR=../dashboard/dist

# ───── CoAP sensor ingest (UDP) ─────

# Bind address for the CoAP server. Default: :: (all IPv6, which includes the Thread side).
# Firewall UDP COAP_PORT to the Thread interface only (see docs/README.md).
COAP_HOST=::

# UDP port sensor nodes send POST /sensor to. Default: 5683.
COAP_PORT=5683

# ───── actuator (pump driver, outbound CoAP) ─────

# Host of the pump actuator. Default: 127.0.0.1. Point it at the real driver (or at the mock
# actuator for development). Loopback with nothing listening means commands fail, which is safe.
ACTUATOR_HOST=127.0.0.1

# UDP port of the actuator. Default: 5684. Matches MOCK_COAP_PORT for the mock.
ACTUATOR_PORT=5684

# Per-request timeout for one CoAP exchange with the actuator, in ms. Default: 3000.
ACTUATOR_TIMEOUT_MS=3000

# ───── PostgreSQL ─────

# Connection string. Default: postgres://greenhouse@localhost:5432/greenhouse (no password).
# Dev: set a password, e.g. postgres://greenhouse:devpass@localhost:5432/greenhouse
# install.sh generates a hex password and writes it here (root-only file).
DATABASE_URL=postgres://greenhouse@localhost:5432/greenhouse

# Max pooled connections. Default: 4. Keep small on a Pi.
DB_POOL_MAX=4

# In-memory readings kept while the DB is down (oldest dropped on overflow). Default: 5000.
DB_BUFFER_MAX=5000

# Per-query deadline in ms (min 100). Default: 5000. Bounds the rules loop and the pump OFF path
# so a hung DB cannot stall them. Source: edge/src/config/index.ts.
DB_QUERY_TIMEOUT_MS=5000

# Connect deadline in ms (min 100). Default: 3000. Source: edge/src/config/index.ts.
DB_CONNECT_TIMEOUT_MS=3000

# ───── soil normalisation (boot defaults, overridden by calibration in the DB) ─────

# Raw ADC reading (0..4095) for AIR / dry soil. Default: 3000 (PLACEHOLDER, calibrate!).
SOIL_DRY_RAW=3000

# Raw ADC reading (0..4095) for WATER / saturated soil. Default: 1200 (PLACEHOLDER, calibrate!).
# Must differ from SOIL_DRY_RAW. A wetter soil reads LOWER raw values.
SOIL_WET_RAW=1200

# ───── loop and housekeeping ─────

# Rules engine tick in ms. Default: 1000.
RULES_TICK_MS=1000

# Readings older than this many days are purged daily. 0 or negative disables purging.
# Default: 90.
RETENTION_DAYS=90

# Cloud outbox forwarding. true | false | 1 | 0 (other values are rejected). Default: false.
# Off until the cloud gateway exists. The outbox is unbounded while off.
CLOUD_ENABLED=false

# ───── mock actuator (standalone `pnpm mock-actuator` only; the edge ignores these) ─────

# Bind host of the mock. Default: 127.0.0.1.
# MOCK_COAP_HOST=127.0.0.1

# Bind port of the mock. Default: ACTUATOR_PORT (5684) if unset.
# MOCK_COAP_PORT=5684

# Fraction 0..1 of requests silently dropped before processing. Default: 0.
# MOCK_DROP_RATE=0

# 1 or true: PUT is applied but the reply is withheld (tests retry and idempotency). Default: off.
# MOCK_NEVER_ACK=0

# Delay in ms before every reply, >= 0. Default: 0.
# MOCK_DELAY_MS=0
